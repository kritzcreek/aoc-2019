module intcode
exports (VM, init_vm, reset_vm, parse, run, add_input, get_output)

use prim
use option
use vec
use io

fn digit(i : I32) -> I64 {
  prim::i64_extend_i32(i - 48)
}

fn is_comma(i : I32) -> Bool {
  i == 44
}

fn is_minus(i : I32) -> Bool {
  i == 45
}

fn parse(input : Bytes) -> Array[I64] {
  let len = prim::bytes_len(input);
  let i = 0;
  let numbers = vec::new#[I64](0);
  let sign : I64 = 1;
  let current : I64 = 0;
  while i < len {
    let c = prim::bytes_get(input, i);
    if is_minus(c) {
      set sign = -1;
    } else {
      if is_comma(c) {
        vec::push(numbers, current * sign);
        set current = 0;
        set sign = 1;
      } else {
        let ten : I64 = 10;
        set current = current * ten + digit(c);
      };
    };
    set i = i + 1;
  };
  vec::push(numbers, current);

  let result = prim::array_new#[I64](0, numbers.len);
  set i = 0;
  while i < numbers.len {
    set result[i] = numbers.buf[i];
    set i = i + 1;
  };
  result
}

variant Mode {
  struct Immediate {},
  struct Position {},
  struct Relative {},
}

fn mode(i : I32) -> Mode {
  if i == 0 { Mode::Position {} } else {
  if i == 1 { Mode::Immediate {} } else {
  if i == 2 { Mode::Relative {} } else {
    prim::panic()
  }}}
}

fn print_mode(mode : Mode) {
  match mode {
    Mode::Immediate _ => { io::println_bytes("IMMEDIATE") },
    Mode::Position _ => { io::println_bytes("POSITION") },
    Mode::Relative _ => { io::println_bytes("RELATIVE") },
  }
}

variant Instruction {
  struct Add { param1 : Mode, param2 : Mode, param3 : Mode },
  struct Mul { param1 : Mode, param2 : Mode, param3 : Mode },
  struct JumpIfTrue { param1 : Mode, param2 : Mode },
  struct JumpIfFalse { param1 : Mode, param2 : Mode },
  struct LessThan { param1 : Mode, param2 : Mode, param3 : Mode },
  struct Equals { param1 : Mode, param2 : Mode, param3 : Mode },
  struct Input { param1 : Mode },
  struct Output { param1 : Mode },
  struct RelativeOffset { param1 : Mode },
  struct Halt { },
}

fn size(i : Instruction) -> I32 {
  match i {
    Instruction::Add _ => { 4 },
    Instruction::Mul _ => { 4 },
    Instruction::LessThan _ => { 4 },
    Instruction::Equals _ => { 4 },
    Instruction::JumpIfTrue _ => { 3 },
    Instruction::JumpIfFalse _ => { 3 },
    Instruction::Input _ => { 2 },
    Instruction::Output _ => { 2 },
    Instruction::RelativeOffset _ => { 2 },
    Instruction::Halt _ => { 1 },
  }
}

fn decode(input : I64) -> Instruction {
  let i : I32 = prim::i32_wrap_i64(input);
  let opcode = i % 100;
  let param1 = mode((i / 100) % 10);
  let param2 = mode((i / 1000) % 10);
  let param3 = mode((i / 10000) % 10);
  if opcode == 1 {
    Instruction::Add { param1 = param1, param2 = param2, param3 = param3 }
  } else {
    if opcode == 2 {
      Instruction::Mul { param1 = param1, param2 = param2, param3 = param3 }
    } else {
      if opcode == 3 {
        Instruction::Input { param1 = param1 }
      } else {
        if opcode == 4 {
          Instruction::Output { param1 = param1 }
        } else {
          if opcode == 5 {
            Instruction::JumpIfTrue { param1 = param1, param2 = param2 }
          } else {
            if opcode == 6 {
              Instruction::JumpIfFalse { param1 = param1, param2 = param2 }
            } else {
              if opcode == 7 {
                Instruction::LessThan { param1 = param1, param2 = param2, param3 = param3 }
              } else {
                if opcode == 8 {
                  Instruction::Equals { param1 = param1, param2 = param2, param3 = param3 }
                } else {
                  if opcode == 9 {
                    Instruction::RelativeOffset { param1 = param1 }
                  } else {
                    Instruction::Halt { }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

struct VM {
  code : Array[I64],
  pc : I32,
  relative_base : I32,
  input : vec::Vec[I64],
  output : vec::Vec[I64],
  running : Bool,
}

fn init_vm(code : Array[I64], size : I32) -> VM {
  let len = prim::array_len(code);
  let copy : Array[I64] = prim::array_new(0, size);
  prim::array_copy(copy, 0, code, 0, len);
  VM { code = copy, pc = 0, relative_base = 0, input = vec::new(0), output = vec::new(0), running = true }
}

fn reset_vm(vm : VM, code : Array[I64]) {
  prim::array_fill(vm.code, 0, 0, prim::array_len(code));
  set vm.pc = 0;
  set vm.running = true;
}

fn add_input(vm : VM, input : I64) {
  vec::push(vm.input, input)
}

fn get_output(vm : VM) -> I64 {
  match vec::pop(vm.output) {
    option::Option::Some s => { s.val },
  }
}

fn read(vm : VM, offset : I32, mode : Mode) -> I64 {
  match mode {
    Mode::Immediate _ => {
      vm.code[offset]
    },
    Mode::Position _ => {
      vm.code[prim::i32_wrap_i64(vm.code[offset])]
    },
    Mode::Relative _ => {
      vm.code[prim::i32_wrap_i64(vm.code[offset]) + vm.relative_base]
    }
  }
}

fn write(vm : VM, offset : I32, mode : Mode, value : I64)  {
  match mode {
    Mode::Position _ => {
      set vm.code[prim::i32_wrap_i64(vm.code[offset])] = value;
    },
    Mode::Relative _ => {
      set vm.code[prim::i32_wrap_i64(vm.code[offset]) + vm.relative_base] = value
    },
  }
}

fn execute(vm : VM, instruction : Instruction) -> Bool {
  match instruction {
    Instruction::Add i => {
      let x = read(vm, vm.pc + 1, i.param1);
      let y = read(vm, vm.pc + 2, i.param2);
      write(vm, vm.pc + 3, i.param3, x + y)
    },
    Instruction::Mul i => {
      let x = read(vm, vm.pc + 1, i.param1);
      let y = read(vm, vm.pc + 2, i.param2);
      write(vm, vm.pc + 3, i.param3, x * y)
    },
    Instruction::JumpIfTrue i => {
      let cond = read(vm, vm.pc + 1, i.param1);
      let zero : I64 = 0;
      when cond != zero {
        set vm.pc = prim::i32_wrap_i64(read(vm, vm.pc + 2, i.param2));
        return true;
      }
    },
    Instruction::JumpIfFalse i => {
      let cond = read(vm, vm.pc + 1, i.param1);
      let zero : I64 = 0;
      when cond == zero {
        set vm.pc = prim::i32_wrap_i64(read(vm, vm.pc + 2, i.param2));
        return true;
      }
    },
    Instruction::LessThan i => {
      let x = read(vm, vm.pc + 1, i.param1);
      let y = read(vm, vm.pc + 2, i.param2);
      write(vm, vm.pc + 3, i.param3, if x < y { 1 } else { 0 })
    },
    Instruction::Equals i => {
      let x = read(vm, vm.pc + 1, i.param1);
      let y = read(vm, vm.pc + 2, i.param2);
      write(vm, vm.pc + 3, i.param3, if x == y { 1 } else { 0 })
    },
    Instruction::Output i => {
      vec::push(vm.output, read(vm, vm.pc + 1, i.param1));
    },
    Instruction::Input i => {
      match vec::pop(vm.input) {
        option::Option::Some s => {
          write(vm, vm.pc + 1, i.param1, s.val);
        },
        option::Option::None _ => {
          return false
        }
      };
    },
    Instruction::RelativeOffset ro => {
      set vm.relative_base = vm.relative_base + prim::i32_wrap_i64(read(vm, vm.pc + 1, ro.param1));
    },
    Instruction::Halt _ => {
      set vm.running = false
    }
  };
  set vm.pc = vm.pc + size(instruction);
  true
}

fn run(vm : VM) {
  while vm.running && vm.pc < prim::array_len(vm.code) {
    let i = decode(vm.code[vm.pc]);
    when execute(vm, i) == false {
      return {};
    }
  }
}

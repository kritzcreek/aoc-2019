  //  l.point.y + t * l.vector.y = p.y
  //  (p.y - l.point.y) / l.vector.x = t
  let t1 = (p.x - l.point.x) /
}

fn main() {
    let points = parse_input(day10_input::input());
    io::print_int(prim::array_len(points));
}
